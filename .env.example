# Harz AI - Environment Variables

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here

# Fine-tuned OpenAI model ID (after running finetune script)
# OPENAI_FINE_TUNED_MODEL=ft:gpt-4o-mini:your-org:harz-ai:xxxxx

# Open-Source Model Server URL
OPEN_SOURCE_API_URL=http://localhost:8000

# Open-Source Model Configuration (for server.py)
# MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# LORA_PATH=./harz-lora
# PORT=8000
# CUDA_AVAILABLE=1
